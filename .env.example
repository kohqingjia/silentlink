# Generate 32 random bytes as hex: python3 -c 'import secrets; print(secrets.token_hex(32))'
# Use hex, not reserved URL characters, because this is also used in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-random-hex
# Existing reverse-proxy Docker network, or create silentlink-edge for a new proxy.
PROXY_NETWORK=silentlink-edge
